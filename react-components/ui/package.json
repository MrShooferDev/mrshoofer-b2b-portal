{
  "name": "@mrshoofer/react-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/types/css.d.ts",
      "default": "./dist/index.css"
    },
    "./fonts.css": {
      "types": "./dist/types/css.d.ts",
      "default": "./fonts/fonts.css"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && esbuild index.ts --bundle --format=esm --target=es2019 --jsx=automatic --external:react --external:react-dom --external:@number-flow/react --outfile=dist/index.js && tsc -p tsconfig.lib.json && node scripts/finalize-types.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
