{
  "schemaVersion": "1.1.0",
  "flowId": "mrshoofer_b2b_registration",
  "locale": "fa-IR",
  "direction": "rtl",
  "title": "ثبت‌نام پنل سازمانی مسترشوفر",
  "purpose": "ثبت اطلاعات فرد ثبت‌نام‌کننده، نوع فعالیت کسب‌وکار، هویت حقیقی یا حقوقی و نیازهای خدماتی برای ایجاد درخواست پنل B2B.",
  "principles": {
    "oneTopicPerStep": true,
    "showProgress": true,
    "allowBackNavigation": true,
    "saveDraftAutomatically": true,
    "allowResume": true,
    "showOnlyRelevantFields": true,
    "doNotAskForUnneededDocuments": true,
    "phoneVerificationRequiredBeforeSubmission": true,
    "avoidDuplicateNameQuestions": "نام و نام خانوادگی مرحله تماس برای ثبت‌نام شخص حقیقی استفاده می‌شود؛ در شاخه شخص حقیقی دوباره پرسیده نمی‌شود."
  },
  "recommendedActivationPolicy": {
    "accountCreatedAfter": "phone_verified",
    "applicationStatusOnSubmit": "submitted",
    "panelStatusOnSubmit": "pending_approval",
    "panelAccessGrantedAfter": "application_approved",
    "note": "این سیاست قابل تنظیم است. اگر فعال‌سازی خودکار انتخاب شود، پس از اعتبارسنجی لازم panelStatus می‌تواند active شود."
  },
  "steps": [
    {
      "id": "contact",
      "stepNumber": 1,
      "title": "نوع پنل و اطلاعات تماس",
      "description": "ابتدا نوع پنل و دسترسی را انتخاب کنید، سپس اطلاعات مسئول ثبت‌نام را وارد کنید.",
      "progressLabel": "اطلاعات تماس",
      "fields": [
        {
          "id": "access.panel",
          "type": "radioCards",
          "label": "کدام پنل و نوع دسترسی را می‌خواهید؟",
          "required": true,
          "layout": "stack",
          "options": [
            {
              "value": "agency",
              "label": "پنل آژانس",
              "description": "فروش بلیت و خدمات سفر به مشتریان",
              "icon": "globe"
            },
            {
              "value": "organization",
              "label": "پنل سازمان",
              "description": "رزرو سفر برای کارکنان، مهمانان یا مشتریان مجموعه",
              "icon": "building-people"
            }
          ]
        },
        {
          "id": "contact.firstName",
          "type": "text",
          "label": "نام",
          "placeholder": "نام شما",
          "required": true,
          "autocomplete": "given-name",
          "validation": {
            "minLength": 2,
            "maxLength": 60,
            "trim": true
          }
        },
        {
          "id": "contact.lastName",
          "type": "text",
          "label": "نام خانوادگی",
          "placeholder": "نام خانوادگی شما",
          "required": true,
          "autocomplete": "family-name",
          "validation": {
            "minLength": 2,
            "maxLength": 80,
            "trim": true
          }
        },
        {
          "id": "contact.mobile",
          "type": "phone",
          "label": "شماره موبایل",
          "placeholder": "مثلاً ۰۹۱۲۱۲۳۴۵۶۷",
          "helperText": "برای تأیید شماره و پیگیری وضعیت درخواست استفاده می‌شود.",
          "required": true,
          "verification": {
            "method": "otp_sms",
            "mustBeVerifiedToContinue": true
          },
          "normalization": {
            "countryCode": "+98",
            "acceptPersianDigits": true,
            "storeE164": true
          },
          "validation": {
            "country": "IR",
            "mobileOnly": true
          }
        },
        {
          "id": "contact.email",
          "type": "email",
          "label": "ایمیل کاری",
          "placeholder": "name@company.com",
          "helperText": "برای ارسال مکاتبات مرتبط با پنل.",
          "required": false,
          "validation": {
            "maxLength": 150
          }
        }
      ],
      "primaryAction": {
        "label": "تأیید شماره و ادامه",
        "nextStep": "business_profile"
      },
      "backAction": null
    },
    {
      "id": "business_profile",
      "stepNumber": 2,
      "title": "درباره فعالیت شما",
      "description": "نوع فعالیت خود را انتخاب کنید تا سؤال‌های مرتبط با کسب‌وکار شما نمایش داده شود.",
      "progressLabel": "نوع فعالیت",
      "fields": [
        {
          "id": "business.type",
          "type": "radioCards",
          "label": "کدام گزینه فعالیت شما را بهتر توصیف می‌کند؟",
          "helperText": "یک گزینه انتخاب کنید.",
          "required": true,
          "layout": "singleColumnOnMobile_twoColumnsOnDesktop",
          "visibleWhen": {
            "equals": {
              "field": "access.panel",
              "value": "agency"
            }
          },
          "options": [
            {
              "value": "travel_agency",
              "label": "آژانس مسافرتی",
              "description": "ارائه خدمات سفر به مشتریان آژانس"
            },
            {
              "value": "online_travel_platform",
              "label": "پلتفرم یا سامانه فروش آنلاین",
              "description": "فروش یا رزرو آنلاین خدمات سفر"
            },
            {
              "value": "tour_operator",
              "label": "مجری یا برگزارکننده تور",
              "description": "برگزاری تور و تهیه خدمات سفر"
            },
            {
              "value": "tour_seller",
              "label": "فروشنده تور یا بسته سفر",
              "description": "عرضه تورها یا بسته‌های سفر به مشتریان"
            },
            {
              "value": "independent_seller",
              "label": "فروشنده مستقل خدمات سفر",
              "description": "فعالیت به‌صورت فردی و بدون نام تجاری ثبت‌شده"
            },
            {
              "value": "other",
              "label": "سایر",
              "description": "فعالیتی که در گزینه‌های بالا نیست"
            }
          ],
          "ui": {
            "control": "selectableCards",
            "singleSelect": true
          }
        },
        {
          "id": "business.typeOther",
          "type": "text",
          "label": "نوع فعالیت شما چیست؟",
          "placeholder": "نوع فعالیت را توضیح دهید",
          "required": true,
          "visibleWhen": {
            "equals": {
              "field": "business.type",
              "value": "other"
            }
          },
          "validation": {
            "minLength": 2,
            "maxLength": 100,
            "trim": true
          }
        },
        {
          "id": "business.displayName",
          "type": "text",
          "label": "نام کسب‌وکار",
          "placeholder": "نام کسب‌وکار را وارد کنید",
          "helperText": "نامی که با آن خدماتتان را ارائه می‌دهید",
          "requiredWhen": {
            "notEquals": {
              "field": "business.type",
              "value": "independent_seller"
            }
          },
          "required": false,
          "labelByBusinessType": {
            "travel_agency": "نام آژانس مسافرتی",
            "organization": "نام شرکت یا سازمان",
            "online_travel_platform": "نام پلتفرم یا سامانه فروش",
            "tour_operator": "نام مجموعه برگزارکننده تور",
            "tour_seller": "نام کسب‌وکار فروش تور یا بسته سفر",
            "independent_seller": "عنوان فعالیت یا کسب‌وکار شما",
            "other": "نام مجموعه یا کسب‌وکار"
          },
          "placeholderByBusinessType": {
            "travel_agency": "نام آژانس را وارد کنید",
            "organization": "نام شرکت یا سازمان را وارد کنید",
            "online_travel_platform": "نام پلتفرم را وارد کنید",
            "tour_operator": "نام مجموعه را وارد کنید",
            "tour_seller": "نام کسب‌وکار را وارد کنید",
            "independent_seller": "در صورت داشتن نام کسب‌وکار وارد کنید",
            "other": "نام مجموعه یا کسب‌وکار را وارد کنید"
          },
          "validation": {
            "minLength": 2,
            "maxLength": 150,
            "trim": true
          }
        },
        {
          "id": "business.hasWebsite",
          "type": "radioCards",
          "label": "وب‌سایت یا صفحه معرفی دارید؟",
          "required": true,
          "layout": "stack",
          "options": [
            {
              "value": "yes",
              "label": "بله، دارم",
              "description": "در صورت تمایل آدرس را وارد می‌کنید"
            },
            {
              "value": "no",
              "label": "وبسایت ندارم",
              "description": "بدون وب‌سایت یا صفحه معرفی ادامه می‌دهید"
            }
          ]
        },
        {
          "id": "business.websiteOrSocial",
          "type": "urlOrText",
          "label": "آدرس وب‌سایت یا صفحه معرفی",
          "placeholder": "مثلاً example.com یا @yourpage",
          "required": false,
          "visibleWhen": {
            "equals": {
              "field": "business.hasWebsite",
              "value": "yes"
            }
          },
          "validation": {
            "maxLength": 250,
            "allowUrlOrHandle": true,
            "trim": true
          }
        }
      ],
      "primaryAction": {
        "label": "ادامه",
        "nextStep": "identity"
      },
      "backAction": {
        "label": "بازگشت",
        "previousStep": "contact"
      }
    },
    {
