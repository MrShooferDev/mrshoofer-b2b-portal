  "logicRules": [
    {
      "id": "business_type_dynamic_name_label",
      "when": {
        "isSet": {
          "field": "business.type"
        }
      },
      "then": [
        {
          "action": "setLabelFromMap",
          "field": "business.displayName",
          "map": "labelByBusinessType"
        },
        {
          "action": "setPlaceholderFromMap",
          "field": "business.displayName",
          "map": "placeholderByBusinessType"
        }
      ]
    },
    {
      "id": "other_business_type_explanation",
      "when": {
        "equals": {
          "field": "business.type",
          "value": "other"
        }
      },
      "then": [
        {
          "action": "show",
          "field": "business.typeOther"
        },
        {
          "action": "require",
          "field": "business.typeOther"
        }
      ]
    },
    {
      "id": "independent_seller_business_name_optional",
      "when": {
        "equals": {
          "field": "business.type",
          "value": "independent_seller"
        }
      },
      "then": [
        {
          "action": "setRequired",
          "field": "business.displayName",
          "value": false
        }
      ]
    },
    {
      "id": "legal_form_branch",
      "when": {
        "isSet": {
          "field": "identity.legalForm"
        }
      },
      "then": [
        {
          "action": "showWhenEquals",
          "fieldGroup": "individual_identity_fields",
          "field": "identity.legalForm",
          "value": "individual"
        },
        {
          "action": "showWhenEquals",
          "fieldGroup": "legal_entity_fields",
          "field": "identity.legalForm",
          "value": "legal_entity"
        },
        {
          "action": "clearHiddenFieldValues",
          "scope": "identity"
        }
      ]
    },
    {
      "id": "legal_entity_business_name_prefill",
      "when": {
        "all": [
          {
            "equals": {
              "field": "identity.legalForm",
              "value": "legal_entity"
            }
          },
          {
            "isEmpty": {
              "field": "identity.legalName"
            }
          }
        ]
      },
      "then": [
        {
          "action": "copyValue",
          "from": "business.displayName",
          "to": "identity.legalName",
          "onlyIfEmpty": true
        }
      ]
    },
    {
      "id": "legal_entity_activity_options_by_business_type",
      "when": {
        "all": [
          {
            "equals": {
              "field": "identity.legalForm",
              "value": "legal_entity"
            }
          },
          {
            "isSet": {
              "field": "business.type"
            }
          }
        ]
      },
      "then": [
        {
          "action": "setOptionsFromMap",
          "field": "identity.activityAreas",
          "map": "optionsByBusinessType",
          "keyField": "business.type"
        }
      ]
    },
    {
      "id": "activity_other_details",
      "when": {
        "all": [
          {
            "equals": {
              "field": "identity.legalForm",
              "value": "legal_entity"
            }
          },
          {
            "contains": {
              "field": "identity.activityAreas",
              "value": "other"
            }
          }
        ]
      },
      "then": [
        {
          "action": "show",
          "field": "identity.activityAreasOther"
        }
      ]
    },
    {
      "id": "service_prompt_by_business_type",
      "when": {
        "isSet": {
          "field": "business.type"
        }
      },
      "then": [
        {
          "action": "setLabelFromMap",
          "field": "preferences.services",
          "map": "labelByBusinessType"
        }
      ]
    },
    {
      "id": "services_not_sure_exclusive",
      "when": {
        "contains": {
          "field": "preferences.services",
          "value": "not_sure"
        }
      },
      "then": [
        {
          "action": "makeExclusiveSelection",
          "field": "preferences.services",
          "value": "not_sure"
        }
      ]
    },
    {
      "id": "source_other_details",
      "when": {
        "equals": {
          "field": "attribution.source",
          "value": "other"
        }
      },
      "then": [
        {
          "action": "show",
          "field": "attribution.sourceOther"
        },
        {
          "action": "require",
          "field": "attribution.sourceOther"
        }
      ]
    },
    {
      "id": "clear_hidden_values",
      "when": {
        "onAnyConditionChange": true
      },
      "then": [
        {
          "action": "clearValuesForHiddenFields"
        },
        {
          "action": "excludeHiddenFieldsFromValidationAndPayload"
        }
      ]
    }
  ],
