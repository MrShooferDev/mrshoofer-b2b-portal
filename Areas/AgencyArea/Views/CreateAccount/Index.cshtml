@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" class="light" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ثبت‌نام پنل سازمانی | مسترشوفر</title>
  <link rel="preload" href="~/farsi-fonts/woff2/iransansx-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="~/farsi-fonts/woff2/iransansx-medium.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="~/farsi-fonts/woff2/iransansx-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="stylesheet" href="~/farsi-fonts/font.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/js/react/heroui.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/js/react/create-account.css" asp-append-version="true" />
  <style>
    /* Same Persian baseline as front pages (rtl.css / IRANSansX weight families) */
    html, body, .ca-page, .reg-root {
      font-family: font-regular, "IRANSansX", Tahoma, sans-serif;
      letter-spacing: 0;
    }
    .ca-page {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      background: #f2f2f7;
      color: oklch(0.2103 0.0059 285.89);
      font-feature-settings: "ss02";
      -webkit-font-feature-settings: "ss02";
      /* Persian UI: open leading, not the 1.85 marketing measure */
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    .reg-root h1, .reg-root h2, .reg-root h3,
    .reg-title, .reg-step__title {
      font-family: font-bold, "IRANSansX", Tahoma, sans-serif;
      letter-spacing: 0;
      line-height: 1.35;
    }
    .reg-root button, .reg-root .reg-btn,
    .reg-root strong, .reg-progress__current {
      font-family: font-medium, "IRANSansX", Tahoma, sans-serif;
      letter-spacing: 0;
    }
    .reg-root input, .reg-root textarea, .reg-root select {
      font-family: font-regular, "IRANSansX", Tahoma, sans-serif;
      letter-spacing: 0;
    }
    .reg-root [data-slot="description"],
    .reg-root .description,
    .reg-help,
    .reg-step-desc,
    .reg-card__desc {
      font-family: font-regular, "IRANSansX", Tahoma, sans-serif !important;
      font-weight: 400 !important;
      letter-spacing: 0;
    }
    .reg-root input::placeholder,
    .reg-root textarea::placeholder {
      font-family: font-regular, "IRANSansX", Tahoma, sans-serif !important;
      font-weight: 400 !important;
      color: rgba(60, 60, 67, 0.3);
      opacity: 1;
    }
  </style>
</head>
<body class="ca-page">
  @Html.AntiForgeryToken()
  <div data-b2b-registration></div>
  <script src="~/js/react/create-account.js" asp-append-version="true"></script>
</body>
</html>
