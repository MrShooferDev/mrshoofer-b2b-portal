# Agency — standalone / local Docker
# Copy to .env (gitignored), fill values, then:
#   docker compose up --build
#
# Production platform stack does NOT use this file.
# Prod secrets come from infra/secrets/agency.env (or SECRETS_DIR inventory).

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5005

# Required — ASP.NET connection string names the app already reads
ConnectionStrings__production=Host=127.0.0.1;Port=5432;Database=ORG;Username=root;Password=CHANGE_ME
ConnectionStrings__development=Host=127.0.0.1;Port=5432;Database=ORG;Username=root;Password=CHANGE_ME

# SMS.ir
smsirapikey=
smsirlinenumber=

# Optional local publish port (compose maps host → container)
AGENCY_HOST_PORT=5005
