# =============================================================================
# Shoofer Compose secrets — copy to .env (gitignored). NEVER commit .env
# =============================================================================

# --- Source roots for image builds (absolute paths on the build machine) ---
ORS_SRC=/tmp/shoofer-src/ors
ORG_SRC=/tmp/shoofer-src/org
AGENCY_SRC=/tmp/shoofer-src/agency
MARKETING_SRC=/tmp/shoofer-src/landing

# --- Postgres (Compose service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ORG
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1.0
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_EFFECTIVE_CACHE=1GB

# --- App DB connection strings (Host=postgres = Compose DNS) ---
# ORS → ConnectionStrings:PostgreSQL  (DB sand_box)
ORS_CONNECTION_STRING=Host=postgres;Port=5432;Database=sand_box;Username=root;Password=CHANGE_ME;Maximum Pool Size=70;Minimum Pool Size=5;Connection Idle Lifetime=60

# Agency / Sale → ConnectionStrings:production (and development fallback)
AGENCY_CONNECTION_STRING=Host=postgres;Port=5432;Database=ORG;Username=root;Password=CHANGE_ME
ORG_CONNECTION_STRING=Host=postgres;Port=5432;Database=ORG;Username=root;Password=CHANGE_ME

# Driver → ConnectionStrings:DefaultConnection
DRIVER_CONNECTION_STRING=Host=postgres;Port=5432;Database=mrshoofer_db;Username=mrshoofer_app;Password=CHANGE_ME

# --- Shared app secrets (mapped to config keys the apps already read) ---
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=

# --- Resource caps (6GB VPS) ---
ORS_MEM_LIMIT=1536m
ORS_CPUS=1.0
AGENCY_MEM_LIMIT=768m
AGENCY_CPUS=0.75
ORG_MEM_LIMIT=768m
ORG_CPUS=0.75
DRIVER_MEM_LIMIT=512m
DRIVER_CPUS=0.5
MARKETING_MEM_LIMIT=512m
MARKETING_CPUS=0.5
KUMA_MEM_LIMIT=256m
KUMA_CPUS=0.25

# --- Marketing build args + runtime file ---
MARKETING_ENV_FILE=./.env.marketing
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=true
NEXT_PUBLIC_POSTHOG_SESSION_RECORDING=true
NEXT_PUBLIC_POSTHOG_AUTOCAPTURE=true
NEXT_PUBLIC_POSTHOG_WEB_VITALS=true
